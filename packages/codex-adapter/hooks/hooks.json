{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/session-start.mjs\"",
            "commandWindows": "node ${PLUGIN_ROOT}/scripts/session-start.mjs",
            "statusMessage": "claw context: loading plan context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/knowledge-finalizer.mjs\"",
            "commandWindows": "node ${PLUGIN_ROOT}/scripts/knowledge-finalizer.mjs",
            "timeout": 30,
            "statusMessage": "auto-doc: capturing plan report"
          }
        ]
      }
    ]
  }
}
